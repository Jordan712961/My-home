{
  "name": "health-wellness-backend",
  "version": "0.1.0",
  "description": "Health & Wellness App Backend API",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "typeorm migration:run -d dist/src/database.js",
    "db:migrate:generate": "typeorm migration:generate",
    "db:seed": "ts-node src/database/seeders/index.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typeorm": "^0.3.16",
    "pg": "^8.11.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.2",
    "joi": "^17.10.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/jest": "^29.5.7",
    "typescript": "^5.1.6",
    "tsx": "^3.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1"
  }
}
